# Local Vite dev: proxy /api → this host (no /api suffix)
VITE_API_TARGET=https://taskbackend-oiuia.ondigitalocean.app

# Production build (DigitalOcean build-time): axios calls this URL directly
# Must include /api — paths in code are /auth/login, /projects, etc.
# VITE_API_URL=https://your-backend.onrender.com/api

# Production runtime (DigitalOcean app env): server.js proxy target (no /api suffix)
# API_TARGET=https://your-backend.onrender.com
